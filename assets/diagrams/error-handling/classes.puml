@startuml
hide empty members
title "Error Handling"
class ErrorFixer {
  +fix(errors_txt_dir: str, errors: List<RenpyError>,reader:Reader,writer:Writer,deleter:Deleter)
}
class ErrorParser {
  {static}-destPat: Regex
  {static}-typePat: Regex
  {static}-lineNumPat: Regex
  {static}-formatErrorType(): str
  {static}-addError(errors: Dictionary<str,List<RenpyError>>,error: RenpyError)
  {static}-parseError(projectDir:str,line:str): RenpyError
  {static}-regexMatch(pattern:Regex,line:str, transformFunc): str
  {static}+getErrors(errors_txt:Path, reader:Reader): Dictionary<str,List<RenpyError>>
 } 
dataclass RenpyError {
  +projectDir:Union[str,None]
  +line_num:Union[int,None]
  +file_loc:Union[str,None]
  +category:Union[str,None]
} 
enum ErrorType {
  NON_EMPTY
  INDENTED_LINE 
  EXPECTED_STATEMENT
  INDENT_MISMATCH 
  DUPLICATE
  MENU_NO_CHOICES
}
ErrorFixer "1" ..> "many" RenpyError:uses
ErrorParser ..>  RenpyError: uses
@enduml
